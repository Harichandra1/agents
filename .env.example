# Copy to .env and fill in. .env is gitignored and must never be committed.
OPENAI_API_KEY=

# Optional — LangSmith tracing (Days 2–3 env; Day 14 demo reads these)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-harness
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional — override the models from harness/config.py
# HARNESS_MODEL=openai:gpt-6-luna
# HARNESS_REASONING_EFFORT=medium
# HARNESS_SUMMARIZER=openai:gpt-5.6-luna
